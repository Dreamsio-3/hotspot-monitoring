# 数据库
DATABASE_URL="file:./dev.db"

# 服务器配置
PORT=3001
CLIENT_URL=http://localhost:5173

# OpenRouter AI（用于热点内容分析和相关性判断）
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Twitter API (twitterapi.io)
TWITTER_API_KEY=your_twitter_api_key_here

# GitHub API (可选；不配置时使用匿名请求，限额更低)
# 只需要公开仓库读取权限，不要申请写权限
GITHUB_TOKEN=your_github_token_here
GITHUB_TIMEOUT_MS=10000

# 邮件通知 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=notify_to@example.com

# ============================================================
# V2: 定时扫描调度器配置
# ============================================================
# 调度器默认启用，间隔 30 分钟。可通过 API 或前端面板动态修改。
# 允许的间隔：5、10、15、30、60 分钟
# 这些值保存在数据库 SchedulerState 表中，.env 不直接控制，
# 但首次启动时会使用 schema 默认值（enabled=true, interval=30）。

# ============================================================
# 来源采集说明
# ============================================================
# Bing / Google / 搜狗：HTML 页面抓取，无需 API Key。
#   - 内置频率限制（Bing 5s, Google 10s, 搜狗 3s）
#   - 可能遇到验证码、结构变化或地区差异，失败时降级为空结果
# 微博：使用热搜公开 API，无需登录或 API Key。
# Bilibili：使用公开搜索 API，无需 API Key。
# Hacker News：使用 Algolia 公开 API，无需 API Key。
# 所有来源独立执行，单个来源失败不影响其它来源和关键词。
