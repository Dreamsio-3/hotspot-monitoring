// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Keyword {
  id        String    @id @default(uuid())
  text      String    @unique
  category  String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  hotspots  Hotspot[]
  scanStates KeywordScanState[]
}

model Hotspot {
  id              String    @id @default(uuid())
  title           String
  content         String
  url             String
  source          String    // twitter, bing, google
  sourceId        String?   // 原始推文ID等
  eventType       String?   // github: repository or release
  repoFullName    String?
  starCount       Int?
  forkCount       Int?
  watcherCount    Int?      // GitHub subscribers_count, not watchers_count
  language        String?
  releaseTagName  String?
  releaseIsPrerelease Boolean?
  pushedAt        DateTime? // GitHub repository last push time
  isReal          Boolean   @default(true)
  relevance       Int       @default(0)
  relevanceReason String?   // AI 分析相关性的理由
  keywordMentioned Boolean?  // 内容中是否直接提及了关键词
  importance      String    @default("low")
  summary         String?
  viewCount       Int?
  likeCount       Int?
  retweetCount    Int?
  replyCount      Int?      // 回复数
  commentCount    Int?      // 评论数
  quoteCount      Int?      // 引用/转引数
  danmakuCount    Int?      // 弹幕数 (Bilibili)
  authorName      String?   // 作者名称
  authorUsername  String?   // 作者用户名
  authorAvatar    String?   // 作者头像
  authorFollowers Int?      // 作者粉丝数
  authorVerified  Boolean?  // 作者是否认证
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  keywordId       String?
  keyword         Keyword?  @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  @@unique([url, source])
  @@index([source, sourceId])
  @@index([keywordId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // hotspot, alert
  title     String
  content   String
  isRead    Boolean  @default(false)
  hotspotId String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// 调度器单例配置与最近一次运行状态（id 固定为 default）
model SchedulerState {
  id              String    @id @default("default")
  enabled         Boolean   @default(true)
  intervalMinutes Int       @default(30)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastRunStatus   String?   // success, partial, failed, empty
  lastRunError    String?
  lastRunSummary  String?   // JSON: 新增/更新/过滤数量和各来源统计
  runToken        String?   // 运行令牌，非空表示有任务在执行
  runStartedAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

// 关键词 × 来源的增量扫描水位
model KeywordScanState {
  id               String    @id @default(uuid())
  keywordId        String
  source           String
  lastStartedAt    DateTime?
  lastSuccessAt    DateTime?
  watermarkAt      DateTime? // 已成功处理内容的最新发布时间
  lastResultCount  Int       @default(0)
  lastNewCount     Int       @default(0)
  lastUpdatedCount Int       @default(0)
  lastDurationMs   Int?
  lastStatus       String?   // success, empty, failed
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  keyword          Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, source])
}

// 扫描任务运行记录
model ScanRun {
  id            String    @id @default(uuid())
  trigger       String    // schedule, manual
  status        String    // running, success, partial, failed, empty
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  keywordCount  Int       @default(0)
  newCount      Int       @default(0)
  updatedCount  Int       @default(0)
  filteredCount Int       @default(0)
  sourceStats   String?   // JSON
  error         String?

  @@index([startedAt])
}
